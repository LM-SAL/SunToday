SUNTODAY_HOST_SAVE_DIRECTORY=/opt/SunInTime
SUNTODAY_JSOC_BASE_URL=http://jsoc.stanford.edu
SUNTODAY_S3_BUCKET=s3://suntoday.lmsal.com/sdomedia/SunInTime
AWS_DEFAULT_REGION=us-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
